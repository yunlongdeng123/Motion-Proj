+    def _a3_optimizer_parameters(self) -> Dict[str, torch.nn.Parameter]:
+        optimizer_ids = {
+            id(parameter)
+            for group in self.optimizer.param_groups
+            for parameter in group["params"]
+        }
+        parameters = {}
+        for class_name, model in self.models.items():
+            for parameter_name, parameter in model.named_parameters():
+                if id(parameter) in optimizer_ids:
+                    parameters[f"{class_name}.{parameter_name}"] = parameter
+        if len(parameters) != len(optimizer_ids):
+            raise RuntimeError("A3 could not name every optimizer parameter")
+        return parameters
+
+    def _initialize_a3_local_refinement(self) -> None:
+        cfg = self.a3_local_refinement_cfg
+        if cfg is None or not bool(cfg.get("enabled", False)):
+            return
+        if (
+            cfg.get("variant") != "r1-reactivate"
+            or cfg.get("engineering_only") is not True
+            or cfg.get("formal_training_authorized") is not False
+        ):
+            raise RuntimeError("A3 R1 engineering boundary drift")
+        if (
+            cfg.get("disable_native_gaussian_postprocess") is not True
+            or cfg.get("require_external_paired_loss_masks") is not True
+            or cfg.get("start_after_checkpoint_step") is not True
+            or cfg.get("native_regularizers_disabled") is not True
+        ):
+            raise RuntimeError("A3 R1 fail-closed controls are missing")
+        if any(
+            bool((self.model_config[class_name].get("reg") or {}))
+            for class_name in self.gaussian_classes
+        ):
+            raise RuntimeError("A3 R1 native Gaussian regularizers remain enabled")
+        if set(self.losses_dict) - {"rgb", "ssim", "mask", "depth"}:
+            raise RuntimeError("A3 R1 auxiliary trainer losses remain enabled")
+        if self.optim_general.get("use_grad_scaler", False):
+            raise RuntimeError("A3 R1 does not authorize gradient scaling")
+        if self.viewer is not None:
+            raise RuntimeError("A3 R1 does not authorize the interactive viewer")
+        sidecar = load_a3_refinement_sidecar(
+            cfg.get("sidecar_manifest"),
+            protocol_sha256=cfg.get("protocol_sha256"),
+            checkpoint_sha256=cfg.get("checkpoint_sha256"),
+            device=self.device,
+        )
+        self.a3_local_refinement_guard = LocalRefinementGuard(
+            parameters=self._a3_optimizer_parameters(),
+            optimizer=self.optimizer,
+            mutable_rows=sidecar.mutable_rows,
+            variant=cfg.get("variant"),
+        )
