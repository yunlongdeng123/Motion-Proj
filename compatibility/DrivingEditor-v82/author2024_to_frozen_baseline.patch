+# Final-paper method profile for an ISOLATED repository/run.
+# Explicit paper facts: 50k iterations, dynamic XYZ lr1.6e-3 ->1.6e-6,
+# LiDAR-only coordinates, photometric DSSIM weight0.2, SGCM dr0.5meters.
+# Other inherited values and the four loss coefficients below are reproduction
+# choices: the final PDF does not report their exact numerical settings.
+exhaust_test: false
+scene_type: "Waymo"
+resolution_scales: [4]  # inherited code value; paper image resolution undisclosed
+fisheye_cam_num: 2
+cam_num: 4
+long_cam_num: 1
+is_fisheye: false
+long_focus: true
+initialization: false
+eval: false  # reconstruction train views; not a claimed paper holdout protocol
+num_pts: 600000  # real LiDAR sampling count is not reported in the paper
+t_init: 0.1
+separate_scaling_t: 0.2
+pos_shift: false
+pos_rotation: false
+reg3d_interval: 10
+reg3d_k: 5
+reg3d_lambda_val: 2
+reg3d_max_points: 100000
+reg3d_sample_size: 1000
+lambda_dssim: 0.2
+is_training: true
+require_boundingbox: false
+nuscenes: false
+iterations: 50000
+position_lr_max_steps: 50000
+# User-requested matched checkpoints/evaluation at every 10,000 steps.
+checkpoint_iterations: [10000, 20000, 30000, 40000, 50000]
+save_iterations: [10000, 20000, 30000, 40000, 50000]
+test_iterations: [10000, 20000, 30000, 40000, 50000]
+paper_eval_train_each_checkpoint: true
+including_dynamic: true
+opacity_lr: 0.005
+adding: false
+densify_until_iter: 15000
+dynamic_densify_until_iter: 15000
+densify_grad_threshold: 0.00017
+sh_increase_interval: 2000
+fix_radius: 0.0
+lambda_v_reg: 0.01
+# Dynamic_GaussianModel already multiplies the base initial XYZ LR by10 and
+# leaves the final LR unchanged. Do NOT set the base initial rate to0.0016.
+position_lr_init: 0.00016
+position_lr_final: 0.0000016
+random_init_point: 0
+dynamic_random_init_point: 0
+
+paper_method: true
+# Code-derived pilot coefficients; NOT author-disclosed paper hyperparameters.
+paper_lambda_sky: 0.05  # legacy lambda_sky_opa scale
+paper_lambda_nps: 0.01  # pilot borrowed from legacy velocity penalty, now Eq9 sum
+paper_lambda_dynamic_opacity: 0.05  # legacy opacity coefficient scale, new Eq13
+paper_lambda_depth: 0.1  # legacy lambda_lidar scale, Eq16 normalization, no decay
+paper_lambda_dynamic_rgb: 1.0  # Eq15 coefficient1; set0 for the L_Id ablation
+paper_weight_provenance: "Pilot values borrowed from released-code coefficient scales; all four numerical paper weights are undisclosed."
+paper_nps_sampling: "Both checkerboard parities; four axial one-pixel neighbors; omit image-edge neighbors; Euclidean nearest-static-pixel-center distance; sum, not mean."
+paper_opacity_domain: "Dynamic foreground mask, divided by full image area. Mask domain follows prose; Eq13 omits an explicit mask."
+
+paper_sgcm_enabled: true
+sgcm_dr_m: 0.5  # explicit paper distance tolerance, before scene normalization
+# Scheduling/footprint/budget details below are declared implementation choices.
+# Offset50 avoids modifying point topology on generic densification iterations.
+sgcm_interval: 100
+sgcm_offset: 50
+sgcm_start: 500
+sgcm_end: 15000
+sgcm_max_new_points: 10000
+sgcm_split_radius_px: 20
+sgcm_ground_margin_m: 3.0
+sgcm_ground_cell_m: 0.5
+sgcm_plane_inlier_m: 0.15
+sgcm_ground_min_cells: 30
+sgcm_ground_min_fraction: 0.35
+sgcm_ground_max_tilt_deg: 20
+sgcm_ground_max_rmse_m: 0.10
