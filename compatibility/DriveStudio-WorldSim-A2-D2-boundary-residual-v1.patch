@@ -131,0 +160,94 @@ class RigidNodes(VanillaGaussians):
+    @property
+    def a2_boundary_residual_enabled(self) -> bool:
+        return self._a2_boundary_residual_enabled
+
+    @property
+    def a2_boundary_residual_policy(self) -> BoundaryResidualPolicy:
+        if self._a2_boundary_residual_policy is None:
+            raise RuntimeError("A2-D2 boundary/residual policy is disabled")
+        return self._a2_boundary_residual_policy
+
+    def record_a2_d2_projected_observations(
+        self,
+        *,
+        filtered_indices: torch.Tensor,
+        boundary: torch.Tensor,
+        photometric_residual: torch.Tensor,
+    ) -> None:
+        if not self._a2_boundary_residual_enabled:
+            return
+        if self._a2_ancestry is None or self._a2_boundary_residual_state is None:
+            raise RuntimeError("A2-D2 state is not initialized")
+        filtered_indices = filtered_indices.to(
+            device=self.device, dtype=torch.long
+        ).flatten()
+        visible_full_indices = torch.where(self.filter_mask)[0]
+        if filtered_indices.numel() and (
+            int(filtered_indices.min()) < 0
+            or int(filtered_indices.max()) >= visible_full_indices.numel()
+        ):
+            raise IndexError("A2-D2 filtered index is outside RigidNodes")
+        full_indices = visible_full_indices[filtered_indices]
+        self.record_a2_diagnostics(
+            indices=full_indices,
+            boundary_contribution=boundary,
+            photometric_residual=photometric_residual,
+        )
+        self._a2_boundary_residual_state.record_observations(
+            boundary_count=int(boundary.numel()),
+            residual_count=int(photometric_residual.numel()),
+        )
+
+    def _apply_a2_d2_scale_cap(
+        self, *, optimizer: torch.optim.Optimizer, maximum_scale: float
+    ) -> torch.Tensor:
+        if not self._a2_boundary_residual_enabled:
+            return torch.zeros(
+                self.num_points, device=self.device, dtype=torch.bool
+            )
+        if self._a2_ancestry is None or self._a2_boundary_residual_state is None:
+            raise RuntimeError("A2-D2 state is not initialized")
+        updated, capped = apply_boundary_scale_cap(
+            log_scales=self._scales.detach(),
+            boundary_mean=self._a2_ancestry.boundary_contribution,
+            boundary_count=self._a2_ancestry.boundary_contribution_count,
+            maximum_scale=maximum_scale,
+        )
+        if capped.any():
+            self._scales.data.copy_(updated)
+            group_name = self.class_prefix + "scaling"
+            matching = [
+                group for group in optimizer.param_groups
+                if group["name"] == group_name
+            ]
+            if len(matching) != 1:
+                raise RuntimeError("A2-D2 could not identify scaling optimizer")
+            parameter = matching[0]["params"][0]
+            state = optimizer.state.get(parameter, {})
+            for key in ("exp_avg", "exp_avg_sq"):
+                value = state.get(key)
+                if value is not None:
+                    value[capped] = 0
+        observed = (
+            self._a2_ancestry.boundary_contribution_count > 0
+        ) & torch.isfinite(self._a2_ancestry.boundary_contribution) & (
+            self._a2_ancestry.boundary_contribution > 0
+        )
+        if observed.any() and torch.any(
+            self.get_scaling[observed].max(dim=-1).values
+            > maximum_scale * (1.0 + 1e-6)
+        ):
+            raise RuntimeError("A2-D2 boundary scale cap was not respected")
+        self._a2_boundary_residual_state.record_refinement(
+            step=self.step,
+            boundary_observed_gaussians=int(
+                (self._a2_ancestry.boundary_contribution_count > 0).sum()
+            ),
+            residual_observed_gaussians=int(
+                (self._a2_ancestry.photometric_residual_count > 0).sum()
+            ),
+            capped_gaussians=int(capped.sum()),
+            maximum_scale=maximum_scale,
+        )
+        return capped
+
