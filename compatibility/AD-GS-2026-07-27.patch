+# Grounded-SAM-2 的 video loader 只按扩展名枚举 JPEG，而 AD-GS 的
+# nuScenes 预处理固定输出 PNG。为保持像素字节不变，在本次 work_dir
+# 中创建指向同一 PNG 内容的 .jpg 硬链接（跨文件系统时复制原始字节）。
+sam2_video_dir = video_dir
+if any(os.path.splitext(name)[-1].lower() == ".png" for name in frame_names):
+    stems = [os.path.splitext(name)[0] for name in frame_names]
+    if len(stems) != len(set(stems)):
+        raise RuntimeError("image 目录存在重复 frame stem，无法创建 SAM2 staging")
+    sam2_video_dir = os.path.join(output_dir, "sam2_frames")
+    os.makedirs(sam2_video_dir, exist_ok=True)
