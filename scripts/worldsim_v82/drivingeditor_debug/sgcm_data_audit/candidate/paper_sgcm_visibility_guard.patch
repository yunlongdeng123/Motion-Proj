+def max_effective_opacity_numpy(opacity, time_center, time_sigma, time_duration):
+    """Exact continuous-time opacity upper bound on an observed time interval.
+
+    The temporal Gaussian peaks at its center if inside the interval; otherwise
+    at its closest endpoint. Spatial Gaussian factors are <=1, so an upper bound
+    below the renderer cutoff proves it cannot contribute any pixel in any
+    observed timestamp. This is not a photometric or ground-geometry threshold.
+    """
+    opacity = np.asarray(opacity, dtype=np.float64).reshape(-1)
+    time_center = np.asarray(time_center, dtype=np.float64).reshape(-1)
+    time_sigma = np.asarray(time_sigma, dtype=np.float64).reshape(-1)
+    duration = np.asarray(time_duration, dtype=np.float64)
+    if (duration.shape != (2,) or not np.isfinite(duration).all() or duration[0] > duration[1]
+            or time_center.shape != opacity.shape or time_sigma.shape != opacity.shape
+            or not np.isfinite(opacity).all() or not np.isfinite(time_center).all()
+            or not np.isfinite(time_sigma).all() or np.any(time_sigma <= 0)
+            or np.any(opacity < 0) or np.any(opacity > 1)):
+        raise SGCMGeometryError('Invalid temporal-opacity visibility inputs')
+    nearest = np.clip(time_center, duration[0], duration[1])
+    distance = np.abs(time_center - nearest)
+    return opacity * np.exp(-0.5 * (distance / time_sigma) ** 2)
 
 
